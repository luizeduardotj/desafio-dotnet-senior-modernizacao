# Copie para .env (não versionado) para trocar os valores de desenvolvimento do docker-compose.yml.
NFSE_VERSAO=0.1.0

# Oracle
ORACLE_PASSWORD=oracle_dev_123
NFSE_OWNER_PASSWORD=nfse_dev_123
NFSE_MODERNO_PASSWORD=moderno_dev_123
NFSE_MODERNO_APP_PASSWORD=moderno_app_dev_123
NFSE_MODERNO_RO_PASSWORD=moderno_ro_dev_123

# Fachada: header X-Admin-Token do kill switch nível 2 (porta 127.0.0.1:8081). Vazio fecha os endpoints.
FACHADA_ADMIN_TOKEN=desenvolvimento-local

# Fachada: fonte das flags, `arquivo` (deploy/flags/flags.json) ou `openfeature` (flagd; suba com --profile flagd).
FACHADA_FLAGS_FONTE=arquivo
