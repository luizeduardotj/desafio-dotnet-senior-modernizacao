+namespace Nfse.Consulta.Api.Domain;
+
+public class Nfse
+{
+    public long Id { get; set; }
+    public long PrestadorId { get; set; }
+    public long Numero { get; set; }
+    public string CodigoVerificacao { get; set; } = "";
+    public DateTime DtEmissao { get; set; }
+    public DateTime Competencia { get; set; }
+    public string ItemServico { get; set; } = "";
+    public string? Discriminacao { get; set; }
+    public decimal ValorServicos { get; set; }
+    public decimal ValorDeducoes { get; set; }
+    public decimal BaseCalculo { get; set; }
+    public decimal Aliquota { get; set; }
+    public decimal ValorIss { get; set; }
+    public string IssRetido { get; set; } = "N";
+    public string TomadorDocumento { get; set; } = "";
+    public string? TomadorRazao { get; set; }
+    public string Situacao { get; set; } = "N";
+    public DateTime? DtCancelamento { get; set; }
+    public string? MotivoCancelamento { get; set; }
+    public long? NfseSubstituidoraId { get; set; }
+    public long? RpsId { get; set; }
+}
+
+public record NfseResumoDto(
+    long PrestadorId,
+    long Numero,
+    DateTime DtEmissao,
+    string ItemServico,
+    decimal ValorServicos,
+    decimal ValorIss,
+    string Situacao);
+
+public record CancelamentoRequest(string Motivo);
