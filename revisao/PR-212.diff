+using System.Net;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Nfse.Consulta.Tests;
+
+public class NfseEndpointsTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public NfseEndpointsTests(WebApplicationFactory<Program> factory)
+    {
+        _factory = factory;
+    }
+
+    [Fact]
+    public async Task ConsultaNfse_DeveResponder()
+    {
+        var client = _factory.CreateClient();
+
+        var resp = await client.GetAsync("/api/v1/nfse/1001/42");
+        Thread.Sleep(500);
+
+        Assert.NotNull(resp);
+    }
+
+    [Fact]
+    public async Task ListaPorTomador_NaoDeveDarErroDeServidor()
+    {
+        var client = _factory.CreateClient();
+
+        var resp = await client.GetAsync("/api/v1/tomadores/12345678000195/nfse?pagina=1");
+
+        Assert.True(resp.StatusCode == HttpStatusCode.OK || resp.StatusCode == HttpStatusCode.InternalServerError);
+    }
+}
