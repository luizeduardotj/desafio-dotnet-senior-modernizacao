+using Nfse.Consulta.Api.Domain;
+using Nfse.Consulta.Api.Infra;
+
+namespace Nfse.Consulta.Api.Endpoints;
+
+public static class NfseEndpoints
+{
+    public static void MapNfseEndpoints(this WebApplication app)
+    {
+        var group = app.MapGroup("/api/v1");
+
+        group.MapGet("/nfse/{prestador:long}/{numero:long}", async (
+            long prestador, long numero, NfseRepository repo, ILogger<NfseRepository> logger) =>
+        {
+            logger.LogInformation($"Consultando NFS-e {numero} do prestador {prestador}");
+
+            var nfse = await repo.ObterPorNumeroAsync(prestador, numero).ConfigureAwait(false);
+
+            return Results.Ok(nfse);
+        });
+
+        group.MapGet("/tomadores/{documento}/nfse", (
+            string documento,
+            NfseRepository repo,
+            ILogger<NfseRepository> logger,
+            DateTime? inicio,
+            DateTime? fim,
+            string? situacao,
+            int pagina = 1,
+            int tamanho = 20) =>
+        {
+            logger.LogInformation($"Listando NFS-e do tomador {documento} - página {pagina}");
+
+            var ini = inicio ?? DateTime.Now.AddDays(-30);
+            var ate = fim ?? DateTime.Now;
+
+            var itens = repo.ListarPorTomadorAsync(documento, ini, ate, pagina, tamanho, situacao ?? "").Result;
+
+            return Results.Ok(new
+            {
+                pagina,
+                tamanho,
+                itens
+            });
+        });
+
+        group.MapPost("/nfse/{prestador:long}/{numero:long}/cancelamento", async (
+            long prestador, long numero, CancelamentoRequest body,
+            NfseRepository repo, ReceitaClient receita, ILogger<NfseRepository> logger) =>
+        {
+            try
+            {
+                var nfse = await repo.ObterPorNumeroAsync(prestador, numero);
+                if (nfse == null)
+                    return Results.NotFound("NFS-e não encontrada");
+
+                if (nfse.Situacao == "C")
+                    return Results.BadRequest("NFS-e já está cancelada");
+
+                // prazo: até dia 10 do mês seguinte à competência
+                var prazo = new DateTime(nfse.Competencia.Year, nfse.Competencia.Month, 10).AddMonths(1);
+                if (DateTime.Now.Date > prazo)
+                    return Results.BadRequest("Prazo de cancelamento expirado");
+
+                if (!await repo.PrestadorRegularAsync(prestador))
+                    return Results.UnprocessableEntity("Prestador não está regular perante a Receita");
+
+                await repo.CancelarAsync(prestador, numero, body.Motivo);
+
+                nfse.Situacao = "C";
+                nfse.DtCancelamento = DateTime.Now;
+                nfse.MotivoCancelamento = body.Motivo;
+
+                logger.LogInformation($"NFS-e {numero} cancelada. Tomador {nfse.TomadorDocumento}");
+                AtualizarCacheSituacao(receita, nfse.TomadorDocumento);
+
+                return Results.Ok(nfse);
+            }
+            catch (Exception ex)
+            {
+                logger.LogError($"Falha no cancelamento: {ex}");
+                return Results.Json(new { erro = ex.Message, detalhe = ex.StackTrace }, statusCode: 500);
+            }
+        });
+    }
+
+    private static async void AtualizarCacheSituacao(ReceitaClient receita, string documento)
+    {
+        await receita.ConsultarSituacaoAsync(documento, ignorarCache: true);
+    }
+}
diff --git a/src/Nfse.Consulta.Api/Infra/NfseRepository.cs b/src/Nfse.Consulta.Api/Infra/NfseRepository.cs
new file mode 100644
index 0000000..3e1fd8f
