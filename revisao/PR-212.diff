+++ b/src/Nfse.Consulta.Api/Infra/NfseRepository.cs
@@ -0,0 +1,153 @@
+#nullable disable
+using System.Data;
+using Nfse.Consulta.Api.Domain;
+using Oracle.ManagedDataAccess.Client;
+
+namespace Nfse.Consulta.Api.Infra;
+
+public class NfseRepository
+{
+    private readonly OracleConnection _conn;
+    private readonly ReceitaClient _receita;
+    private readonly ILogger<NfseRepository> _logger;
+
+    public NfseRepository(IConfiguration config, ReceitaClient receita, ILogger<NfseRepository> logger)
+    {
+        _conn = new OracleConnection(config.GetConnectionString("Nfse"));
+        _receita = receita;
+        _logger = logger;
+    }
+
+    private async Task AbrirAsync()
+    {
+        if (_conn.State != ConnectionState.Open)
+            await _conn.OpenAsync();
+    }
+
+    public async Task<Domain.Nfse> ObterPorNumeroAsync(long prestadorId, long numero)
+    {
+        try
+        {
+            await AbrirAsync();
+
+            using var cmd = _conn.CreateCommand();
+            cmd.CommandText = "SELECT * FROM NFSE WHERE PRESTADOR_ID = :prestador AND NUMERO = :numero";
+            cmd.BindByName = true;
+            cmd.Parameters.Add("prestador", OracleDbType.Int64).Value = prestadorId;
+            cmd.Parameters.Add("numero", OracleDbType.Int64).Value = numero;
+
+            using var reader = await cmd.ExecuteReaderAsync();
+            if (!await reader.ReadAsync())
+                return null;
+
+            return Mapear(reader);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError($"Erro ao consultar NFS-e {numero}: {ex.Message}");
+            return null;
+        }
+    }
+
+    public async Task<List<NfseResumoDto>> ListarPorTomadorAsync(
+        string documento, DateTime inicio, DateTime fim, int pagina, int tamanho, string situacao)
+    {
+        var lista = new List<NfseResumoDto>();
+        await AbrirAsync();
+
+        var sql = "SELECT PRESTADOR_ID, NUMERO, DT_EMISSAO, ITEM_SERVICO, VALOR_SERVICOS, VALOR_ISS, SITUACAO " +
+                  "FROM NFSE WHERE TOMADOR_DOCUMENTO = :doc AND DT_EMISSAO BETWEEN :ini AND :fim";
+
+        if (!string.IsNullOrEmpty(situacao))
+            sql += $" AND SITUACAO = '{situacao}'";
+
+        sql += " ORDER BY DT_EMISSAO DESC OFFSET :off ROWS FETCH NEXT :tam ROWS ONLY";
+
+        using var cmd = _conn.CreateCommand();
+        cmd.CommandText = sql;
+        cmd.BindByName = true;
+        cmd.Parameters.Add("doc", OracleDbType.Int64).Value = long.Parse(documento);
+        cmd.Parameters.Add("ini", OracleDbType.Date).Value = inicio;
+        cmd.Parameters.Add("fim", OracleDbType.Date).Value = fim;
+        cmd.Parameters.Add("off", OracleDbType.Int32).Value = (pagina - 1) * tamanho;
+        cmd.Parameters.Add("tam", OracleDbType.Int32).Value = tamanho;
+
+        using var reader = await cmd.ExecuteReaderAsync();
+        while (await reader.ReadAsync())
+        {
+            lista.Add(new NfseResumoDto(
+                reader.GetInt64(0),
+                reader.GetInt64(1),
+                reader.GetDateTime(2),
+                reader.GetString(3),
+                reader.GetDecimal(4),
+                reader.GetDecimal(5),
+                reader.GetString(6)));
+        }
+
+        return lista;
+    }
+
+    public async Task<bool> PrestadorRegularAsync(long prestadorId)
+    {
+        await AbrirAsync();
+
+        using var cmd = _conn.CreateCommand();
+        cmd.CommandText = "SELECT DOCUMENTO, ATIVO FROM CONTRIBUINTES WHERE ID = :id";
+        cmd.BindByName = true;
+        cmd.Parameters.Add("id", OracleDbType.Int64).Value = prestadorId;
+
+        using var reader = await cmd.ExecuteReaderAsync();
+        if (!await reader.ReadAsync())
+            return false;
+
+        var documento = reader.GetString(0);
+        var ativo = reader.GetString(1) == "S";
+
+        var situacao = _receita.ConsultarSituacao(documento);
+        return ativo && situacao == "ATIVA";
+    }
+
+    public async Task CancelarAsync(long prestadorId, long numero, string motivo)
+    {
+        await AbrirAsync();
+
+        using var cmd = _conn.CreateCommand();
+        cmd.CommandText = "UPDATE NFSE SET SITUACAO = 'C', DT_CANCELAMENTO = SYSDATE, " +
+                          "MOTIVO_CANCELAMENTO = :motivo WHERE PRESTADOR_ID = :prestador AND NUMERO = :numero";
+        cmd.BindByName = true;
+        cmd.Parameters.Add("motivo", OracleDbType.Varchar2).Value = motivo;
+        cmd.Parameters.Add("prestador", OracleDbType.Int64).Value = prestadorId;
+        cmd.Parameters.Add("numero", OracleDbType.Int64).Value = numero;
+
+        await cmd.ExecuteNonQueryAsync();
+    }
+
+    private static Domain.Nfse Mapear(System.Data.Common.DbDataReader r)
+    {
+        return new Domain.Nfse
+        {
+            Id = Convert.ToInt64(r["ID"]),
+            PrestadorId = Convert.ToInt64(r["PRESTADOR_ID"]),
+            Numero = Convert.ToInt64(r["NUMERO"]),
+            CodigoVerificacao = r["CODIGO_VERIFICACAO"].ToString(),
+            DtEmissao = Convert.ToDateTime(r["DT_EMISSAO"]),
+            Competencia = Convert.ToDateTime(r["COMPETENCIA"]),
+            ItemServico = r["ITEM_SERVICO"].ToString(),
+            Discriminacao = r["DISCRIMINACAO"] as string,
+            ValorServicos = Convert.ToDecimal(r["VALOR_SERVICOS"]),
+            ValorDeducoes = Convert.ToDecimal(r["VALOR_DEDUCOES"]),
+            BaseCalculo = Convert.ToDecimal(r["BASE_CALCULO"]),
+            Aliquota = Convert.ToDecimal(r["ALIQUOTA"]),
+            ValorIss = Convert.ToDecimal(r["VALOR_ISS"]),
+            IssRetido = r["ISS_RETIDO"].ToString(),
+            TomadorDocumento = r["TOMADOR_DOCUMENTO"].ToString(),
+            TomadorRazao = r["TOMADOR_RAZAO"] as string,
+            Situacao = r["SITUACAO"].ToString(),
+            DtCancelamento = r["DT_CANCELAMENTO"] is DBNull ? null : Convert.ToDateTime(r["DT_CANCELAMENTO"]),
+            MotivoCancelamento = r["MOTIVO_CANCELAMENTO"] as string,
+            NfseSubstituidoraId = r["NFSE_SUBSTITUIDORA_ID"] is DBNull ? null : Convert.ToInt64(r["NFSE_SUBSTITUIDORA_ID"]),
+            RpsId = r["RPS_ID"] is DBNull ? null : Convert.ToInt64(r["RPS_ID"])
+        };
+    }
+}
