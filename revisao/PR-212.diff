+using System.Net.Http.Json;
+
+namespace Nfse.Consulta.Api.Infra;
+
+public class ReceitaClient
+{
+    private static readonly Dictionary<string, string> _cache = new();
+
+    private readonly string _baseUrl;
+    private readonly ILogger<ReceitaClient> _logger;
+
+    public ReceitaClient(IConfiguration config, ILogger<ReceitaClient> logger)
+    {
+        _baseUrl = config["Receita:BaseUrl"]!;
+        _logger = logger;
+    }
+
+    public async Task<string> ConsultarSituacaoAsync(string documento, bool ignorarCache = false)
+    {
+        if (!ignorarCache && _cache.TryGetValue(documento, out var emCache))
+            return emCache;
+
+        _logger.LogInformation($"Consultando situação cadastral do documento {documento}");
+
+        using var http = new HttpClient();
+        http.BaseAddress = new Uri(_baseUrl);
+
+        var resp = await http.GetAsync($"cnpj/{documento}/situacao").ConfigureAwait(false);
+        resp.EnsureSuccessStatusCode();
+
+        var dto = await resp.Content.ReadFromJsonAsync<SituacaoDto>().ConfigureAwait(false);
+        var situacao = dto!.Situacao;
+
+        _cache[documento] = situacao;
+        return situacao;
+    }
+
+    public string ConsultarSituacao(string documento)
+    {
+        return ConsultarSituacaoAsync(documento).Result;
+    }
+
+    private record SituacaoDto(string Situacao);
+}
