+builder.Services.AddScoped<ReceitaClient>();
+builder.Services.AddSingleton<NfseRepository>();
+
+var app = builder.Build();
+
+app.UseDeveloperExceptionPage();
+app.UseCors();
+
+app.MapNfseEndpoints();
+
+app.Run();
+
+public partial class Program { }
