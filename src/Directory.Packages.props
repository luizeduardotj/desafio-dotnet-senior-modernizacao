<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- fachada (ADR-0008) -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.5" />
    <PackageVersion Include="OpenFeature" Version="2.14.1" />
    <PackageVersion Include="OpenFeature.Contrib.Providers.Flagd" Version="0.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- observabilidade (ADR-0012) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- serviço novo (ADR-0007, ADR-0010) -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <!-- spans do ODP.NET (ADR-0012); a 23.26.300 é a mais recente e aceita o ODP.NET [23.26.300, 24) -->
    <PackageVersion Include="Oracle.ManagedDataAccess.OpenTelemetry" Version="23.26.300" />
    <!-- dependência transitiva do ODP.NET com vulnerabilidade conhecida na 8.0.1 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- testes -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- validação das respostas REST contra o snapshot do OpenAPI (tests/Nfse.Host.Testes/Contrato/ContratoOpenApi.cs) -->
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <!-- testes de propriedade (ADR-0011): período, cursor da REST e documentos; sem dependências transitivas -->
    <PackageVersion Include="CsCheck" Version="4.9.1" />
  </ItemGroup>
</Project>
