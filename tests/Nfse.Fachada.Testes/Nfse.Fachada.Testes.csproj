  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nfse.Fachada/Nfse.Fachada.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pedidos e respostas reais do legado: evidência de comportamento, usados como estão. -->
    <None Include="../../tools/exemplos/*.xml" LinkBase="exemplos" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
